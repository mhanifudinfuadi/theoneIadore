---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Pagination from '~/components/blog/Pagination.astro';
import Breadcrumbs from '~/components/common/Breadcrumbs.astro';
import { getPermalink, getBlogPermalink } from '~/utils/permalinks';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

/**
 * Semua kategori pada halaman ini menggunakan anchor (#...) agar:
 * 1. dropdown navigation tidak menuju route category yang belum tentu tersedia,
 * 2. kartu "Jelajahi Arsip" selalu menuju section yang benar pada halaman ini,
 * 3. tidak muncul 404 hanya karena route category belum dibuat.
 *
 * Filter di bawah sengaja fleksibel terhadap beberapa bentuk frontmatter:
 * category: "pajak"
 * category: { name: "Pajak" }
 * categories: ["pajak", "kebijakan"]
 * tags: ["pajak"]
 */
const normalizeTaxonomyValue = (value: unknown): string[] => {
  if (!value) return [];

  if (typeof value === 'string') {
    return value
      .split(',')
      .map((item) => item.trim().toLowerCase())
      .filter(Boolean);
  }

  if (Array.isArray(value)) {
    return value.flatMap((item) => normalizeTaxonomyValue(item));
  }

  if (typeof value === 'object') {
    const item = value as Record<string, unknown>;

    return [
      item.slug,
      item.name,
      item.title,
      item.label,
    ].flatMap((entry) => normalizeTaxonomyValue(entry));
  }

  return [];
};

const taxonomyForPost = (post: unknown): string[] => {
  const data = (post as { data?: Record<string, unknown> })?.data ?? {};

  return [
    ...normalizeTaxonomyValue(data.category),
    ...normalizeTaxonomyValue(data.categories),
    ...normalizeTaxonomyValue(data.tags),
  ];
};

const breadcrumbs = [
  { text: 'Home', href: getPermalink('/') },
  ...(currentPage > 1
    ? [
        { text: 'Tulisan & Opini', href: getBlogPermalink() },
        { text: `Halaman ${currentPage}` },
      ]
    : [{ text: 'Tulisan & Opini' }]),
];

const categoryMatchers: Record<string, string[]> = {
  'pajak-kebijakan': [
    'pajak',
    'kebijakan',
    'pajak & kebijakan',
    'pajak-kebijakan',
    'fiskal',
    'apbn',
    'umkm',
  ],
  'edukasi-literasi': [
    'edukasi',
    'literasi',
    'edukasi & literasi',
    'edukasi-literasi',
    'tax center',
    'tax-center',
    'pendidikan',
    'penulisan',
  ],
  'refleksi-catatan': [
    'refleksi',
    'catatan',
    'refleksi & catatan',
    'refleksi-catatan',
    'personal',
    'perjalanan',
  ],
  'editorial-publikasi': [
    'editorial',
    'publikasi',
    'editorial & publikasi',
    'editorial-publikasi',
    'editing',
    'editor',
  ],
  'media-komunikasi': [
    'media',
    'komunikasi',
    'media & komunikasi',
    'media-komunikasi',
    'siniar',
    'podcast',
    'moderator',
    'public relations',
    'kehumasan',
  ],
};

const postsForCategory = (slug: string) => {
  const matchers = categoryMatchers[slug] ?? [];

  return page.data.filter((post) => {
    const taxonomy = taxonomyForPost(post);
    return taxonomy.some((value) => matchers.includes(value));
  });
};

const categories = [
  {
    slug: 'semua-karya',
    title: 'Semua Karya',
    description: 'Seluruh tulisan, refleksi, editorial, dan karya komunikasi.',
    href: '#semua-karya',
    icon: '✦',
  },
  {
    slug: 'pajak-kebijakan',
    title: 'Pajak & Kebijakan',
    description: 'Pajak, kebijakan fiskal, APBN, UMKM, dan isu kebijakan publik.',
    href: '#pajak-kebijakan',
    icon: '税',
  },
  {
    slug: 'edukasi-literasi',
    title: 'Edukasi & Literasi',
    description: 'Pendidikan, literasi, Tax Center, penulisan, dan berbagi pengetahuan.',
    href: '#edukasi-literasi',
    icon: '学',
  },
  {
    slug: 'refleksi-catatan',
    title: 'Refleksi & Catatan',
    description: 'Catatan personal, perjalanan, pengalaman, dan cerita di balik angka.',
    href: '#refleksi-catatan',
    icon: '記',
  },
  {
    slug: 'editorial-publikasi',
    title: 'Editorial & Publikasi',
    description: 'Jejak penyuntingan, publikasi kelembagaan, dan karya editorial.',
    href: '#editorial-publikasi',
    icon: '編',
  },
  {
    slug: 'media-komunikasi',
    title: 'Media & Komunikasi',
    description: 'Siniar, moderator, media, gelar wicara, dan komunikasi publik.',
    href: '#media-komunikasi',
    icon: '伝',
  },
];

const metadata = {
  title: `Tulisan & Opini — Ida Rosnida Laila${currentPage > 1 ? ` — Halaman ${currentPage}` : ''}`,
  description:
    'Kumpulan tulisan, opini, refleksi, karya editorial, literasi, dan komunikasi publik Ida Rosnida Laila.',
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {page.url.prev && <link rel="prev" href={page.url.prev} />}
    {page.url.next && <link rel="next" href={page.url.next} />}
  </Fragment>

  <Breadcrumbs bar items={breadcrumbs} />

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
      <div class="max-w-4xl">
        <div
          class="mb-5 inline-flex items-center gap-3 rounded-full border border-pink-200 bg-pink-50/70 px-4 py-2 text-sm font-medium text-gray-700 dark:border-pink-900/40 dark:bg-pink-950/20 dark:text-gray-200"
        >
          <span class="text-pink-500">●</span>
          <span>Tulisan, gagasan & jejak editorial</span>
        </div>

        <h1
          class="text-4xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-5xl"
        >
          Cerita, Opini, dan Refleksi
          <span class="block text-primary-600 dark:text-primary-400">
            di Balik Kebijakan
          </span>
        </h1>

        <p
          class="mt-6 max-w-3xl text-lg leading-8 text-gray-600 dark:text-gray-300"
        >
          Kumpulan tulisan dan jejak kepenulisan Ida Rosnida Laila—
          mulai dari pajak dan kebijakan publik, edukasi dan literasi,
          refleksi personal, hingga karya editorial dan komunikasi publik.
        </p>

        <p
          class="mt-4 max-w-3xl text-base leading-7 text-gray-500 dark:text-gray-400"
        >
          Tidak semua jejak hadir dalam bentuk artikel. Sebagian hadir sebagai
          tulisan, penyuntingan, forum literasi, moderator, siniar, dan
          komunikasi kelembagaan.
        </p>
      </div>
    </div>
  </section>

  <!-- CATEGORY NAVIGATION -->
  <section class="border-y border-gray-200 bg-gray-50/70 dark:border-gray-800 dark:bg-gray-900/30">
    <div class="mx-auto max-w-6xl px-6 py-8 sm:px-6 lg:px-8">
      <div class="mb-5">
        <p
          class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400"
        >
          Jelajahi arsip
        </p>

        <h2 class="mt-2 text-2xl font-bold text-gray-900 dark:text-white">
          Kategori Kepenulisan
        </h2>
      </div>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          categories.map((category, index) => (
            <a
              href={category.href}
              class:list={[
                'group rounded-2xl border p-5 transition duration-200',
                index === 0
                  ? 'border-primary-200 bg-white shadow-sm hover:-translate-y-0.5 hover:shadow-md dark:border-primary-900/50 dark:bg-gray-900'
                  : 'border-gray-200 bg-white/70 hover:-translate-y-0.5 hover:border-primary-200 hover:shadow-sm dark:border-gray-800 dark:bg-gray-900/60 dark:hover:border-primary-900/50',
              ]}
            >
              <div class="flex items-start gap-4">
                <div
                  class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary-50 text-lg text-primary-600 dark:bg-primary-950/40 dark:text-primary-400"
                >
                  {category.icon}
                </div>

                <div>
                  <h3
                    class="font-semibold text-gray-900 transition group-hover:text-primary-600 dark:text-white dark:group-hover:text-primary-400"
                  >
                    {category.title}
                  </h3>

                  <p class="mt-1 text-sm leading-6 text-gray-500 dark:text-gray-400">
                    {category.description}
                  </p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ALL WORKS -->
  <section
    id="semua-karya"
    class="scroll-mt-24 mx-auto max-w-6xl px-6 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20"
  >
    <div
      class="mb-10 flex flex-col gap-5 border-b border-gray-200 pb-8 dark:border-gray-800 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400">
          Arsip
        </p>

        <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">
          Semua Karya
        </h2>

        <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">
          Tulisan dan catatan yang merekam gagasan, pengalaman, serta
          keterlibatan Ida dalam dunia pajak, kebijakan, literasi, editorial,
          dan komunikasi publik.
        </p>
      </div>

      <div
        class="shrink-0 rounded-full border border-gray-200 bg-white px-4 py-2 text-sm text-gray-500 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-400"
      >
        {currentPage > 1 ? `Halaman ${currentPage}` : 'Arsip terbaru'}
      </div>
    </div>

    <BlogList posts={page.data} />

    <div class="mt-12">
      <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
    </div>
  </section>

  <!-- CATEGORY SECTIONS -->
  {
    categories
      .filter((category) => category.slug !== 'semua-karya')
      .map((category) => {
        const posts = postsForCategory(category.slug);

        return (
          <section
            id={category.slug}
            class="scroll-mt-24 border-t border-gray-200 dark:border-gray-800"
          >
            <div class="mx-auto max-w-6xl px-6 py-14 sm:px-6 sm:py-16 lg:px-8 lg:py-20">
              <div class="mb-9 max-w-3xl">
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400">
                  Kategori Kepenulisan
                </p>

                <h2 class="mt-2 text-3xl font-bold text-gray-900 dark:text-white">
                  {category.title}
                </h2>

                <p class="mt-3 text-gray-600 dark:text-gray-400">
                  {category.description}
                </p>
              </div>

              {posts.length > 0 ? (
                <BlogList posts={posts} />
              ) : (
                <div class="rounded-2xl border border-dashed border-gray-300 bg-gray-50/70 p-7 text-gray-600 dark:border-gray-700 dark:bg-gray-900/40 dark:text-gray-400">
                  <p class="font-medium text-gray-900 dark:text-gray-200">
                    Arsip kategori sedang dikembangkan.
                  </p>
                  <p class="mt-2 text-sm leading-6">
                    Belum ada karya pada halaman ini yang memiliki metadata
                    kategori yang cocok dengan "{category.title}". Tautan tetap
                    aktif dan tidak menghasilkan halaman kosong atau 404.
                  </p>
                </div>
              )}
            </div>
          </section>
        );
      })
  }

  <!-- EDITORIAL NOTE -->
  <section class="border-t border-gray-200 dark:border-gray-800">
    <div class="mx-auto max-w-5xl px-6 py-14 sm:px-6 lg:px-8">
      <div
        class="rounded-3xl border border-primary-100 bg-primary-50/50 p-7 dark:border-primary-900/40 dark:bg-primary-950/10 sm:p-9"
      >
        <div class="grid gap-6 md:grid-cols-[auto_1fr] md:items-start">
          <div
            class="flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-xl shadow-sm dark:bg-gray-900"
          >
            ✎
          </div>

          <div>
            <p
              class="text-xs font-semibold uppercase tracking-[0.18em] text-primary-600 dark:text-primary-400"
            >
              Catatan editorial
            </p>

            <h2 class="mt-2 text-2xl font-bold text-gray-900 dark:text-white">
              Menulis bukan satu-satunya cara untuk berkontribusi.
            </h2>

            <p class="mt-4 leading-7 text-gray-600 dark:text-gray-300">
              Arsip ini membedakan karya yang ditulis langsung dengan jejak
              editorial, literasi, moderasi, dan komunikasi publik. Dengan
              demikian, setiap karya dapat dilihat sesuai dengan peran dan
              konteks keterlibatan Ida.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="mx-auto max-w-6xl px-6 pb-16 sm:px-6 lg:px-8 lg:pb-20">
    <div
      class="rounded-3xl bg-gray-900 px-7 py-10 text-white dark:bg-gray-950 sm:px-10 sm:py-12"
    >
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-primary-300">
          Pajak · Kebijakan · Cerita
        </p>

        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Ada cerita di balik setiap angka.
        </h2>

        <p class="mt-4 max-w-2xl leading-7 text-gray-300">
          Dari kebijakan publik hingga cerita masyarakat, dari ruang kelas
          hingga ruang redaksi—setiap tulisan menjadi bagian dari perjalanan
          memahami, menjelaskan, dan menghubungkan.
        </p>
      </div>
    </div>
  </section>
</Layout>
