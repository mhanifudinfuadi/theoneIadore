---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Hubungi Kami | Literasi, Edukasi & Hubungan Kelembagaan Perpajakan',
  description:
    'Layanan komunikasi publik, kemitraan Tax Center, edukasi perpajakan, dan literasi bersama Ida Rosnida Laila, S.H., M.E., M.Ids. (Direktorat Jenderal Pajak).',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->
  <HeroText
    tagline="Kontak & Kolaborasi"
    title="Mari Terhubung & Berkolaborasi!"
    subtitle="Ruang komunikasi untuk sinergi edukasi perpajakan, kemitraan Tax Center perguruan tinggi, literasi publik, dan narasumber/moderator kegiatan."
  />

  <!-- ContactUs Widget ****************** -->
  <ContactUs
    id="form"
    title="Kirimkan Pesan Anda Hari Ini"
    subtitle="Ingin mendiskusikan kemitraan Tax Center, literasi perpajakan, atau kegiatan edukasi publik? Silakan isi formulir di bawah ini."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Nama Lengkap',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Alamat Email',
      },
      {
        type: 'text',
        name: 'institution',
        label: 'Instansi / Perguruan Tinggi / Media',
      },
    ]}
    textarea={{
      label: 'Pesan / Topik Diskusi',
    }}
    disclaimer={{
      label:
        'Dengan mengirimkan formulir ini, Anda menyetujui pengumpulan informasi kontak untuk keperluan korespondensi profesional dan edukasi publik.',
    }}
    description="Pesan Anda akan ditanggapi melalui saluran korespondensi resmi atau kontak profesional."
  />

  <!-- Features2 Widget ****************** -->
  <Features2
    title="Fokus Layanan & Kolaborasi Publik"
    subtitle="Bidang kontribusi publik dan komunikasi kelembagaan yang dikembangkan"
    items={[
      {
        title: 'Kemitraan Tax Center & Kampus',
        description:
          'Inisiasi kerja sama, perpanjangan MoU Tax Center, edukasi pemadanan NIK-NPWP, serta pembinaan Relawan Pajak mahasiswa di berbagai perguruan tinggi.',
        icon: 'tabler:school',
      },
      {
        title: 'Literasi & Lokakarya Penulisan',
        description:
          'Fasilitasi Club Literacy, pelatihan penulisan opini publik, dan pembuatan konten edukasi perpajakan yang relatable bagi mahasiswa dan masyarakat.',
        icon: 'tabler:books',
      },
      {
        title: 'Siniar, Moderasi & Media Visit',
        description:
          'Pengalaman memandu podcast/siniar (seperti TER/PPh 21), moderator lokakarya nasional, serta hubungan media dan sinergi publikasi bersama pers/radio.',
        icon: 'tabler:microphone',
      },
      {
        title: 'Pengalaman Administrasi & Pelayanan Pajak',
        description:
          'Rekam jejak pelayanan wajib pajak, analisis kepatuhan (studi kasus AR), insentif pajak Pemulihan Ekonomi Nasional (PEN), hingga mitigasi pelanggaran pajak.',
        icon: 'tabler:file-text',
      },
      {
        title: 'Kemenkeu Mengajar & Edukasi Publik',
        description:
          'Kontribusi sebagai relawan pengajar dan narasumber kegiatan edukasi publik Kementerian Keuangan untuk membangun kesadaran pajak sejak dini.',
        icon: 'tabler:user-check',
      },
      {
        title: 'Kantor Layanan Resmi (DJP)',
        description: 'KPP Madya Dua Jakarta Barat / Kantor Wilayah DJP (Kementerian Keuangan Republik Indonesia).',
        icon: 'tabler:building-bank', // Atau bisa pakai 'tabler:building'
        callToAction: {
          text: 'Portal Resmi Pajak',
          href: 'https://www.pajak.go.id/id/alamat-kantor/kantor-pelayanan-pajak-madya-dua-jakarta-barat',
        },
      },
    ]}
  />
</Layout>