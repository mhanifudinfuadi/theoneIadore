---
import { Image } from 'astro:assets';

import Features2 from '~/components/widgets/Features2.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Layout from '~/layouts/PageLayout.astro';

import tentangImage1 from '~/assets/images/tentang-1.png';
import tentangImage2 from '~/assets/images/tentang-2.png';

const metadata = {
  title: 'Tentang / プロフィール — Ida Rosnida Laila',
  description:
    'Profil profesional, perjalanan karier di DJP, karya tulis, dan refleksi kepenulisan Ida Rosnida Laila, S.H., M.E., M.Ids.',
};
---

<Layout metadata={metadata}>

  <!-- =========================================================
       HERO
       PAJAK, KEBIJAKAN, DAN CERITA DI BALIK ANGKA
  ========================================================== -->

  <section
    class="mx-auto w-full px-5 pt-5 pb-5
    sm:px-6 sm:pt-6 sm:pb-6
    lg:px-8 lg:pt-7 lg:pb-7"
  >

    <div class="mx-auto w-full max-w-[620px]">

      <!-- TAGLINE -->

      <div class="text-center">

        <div
          class="mb-1
          text-[10px]
          font-semibold
          uppercase
          tracking-[0.08em]
          text-blue-600
          dark:text-blue-400
          sm:text-[11px]"
        >
          ABOUT / プロフィール
        </div>

      </div>


      <!-- TITLE -->

      <h1
        class="font-heading
        text-center
        text-[34px]
        font-bold
        leading-[1.04]
        tracking-[-0.045em]
        text-slate-900
        dark:text-slate-100
        sm:text-[38px]
        md:text-[42px]"
      >

        Pajak, Kebijakan, dan

        <br />

        <span class="text-accent dark:text-blue-400">
          Cerita di Balik Angka
        </span>

      </h1>


      <!-- DESCRIPTION -->

      <p
        class="mx-auto
        mt-3
        max-w-[610px]
        text-center
        text-[10px]
        font-normal
        leading-[1.55]
        text-slate-500
        dark:text-slate-400
        sm:mt-3.5
        sm:text-[11px]
        md:text-[12px]"
      >
        Ida Rosnida Laila, S.H., M.E., M.Ids. adalah profesional perpajakan dan
        komunikator sektor publik di Direktorat Jenderal Pajak, Kementerian
        Keuangan Republik Indonesia. Perjalanan kariernya membentang dari
        pelayanan wajib pajak, komunikasi publik, hubungan kelembagaan, hingga
        edukasi dan literasi perpajakan di tingkat regional.
      </p>


      <!-- HERO IMAGE -->

      <div
        class="mx-auto
        mt-7
        w-full
        sm:mt-8"
      >

        <Image
          src={tentangImage1}
          alt="Perempuan profesional dengan MacBook dalam suasana kerja bertema perpajakan dan kebijakan dengan nuansa Jepang"
          class="block
          h-auto
          w-full
          rounded-lg
          object-cover
          object-center
          shadow-sm
          sm:rounded-xl"
          widths={[520, 620, 760]}
          sizes="(max-width: 640px) 100vw, 620px"
          loading="eager"
          format="webp"
          quality={88}
        />

      </div>

    </div>

  </section>


  <!-- =========================================================
       PUBLIC FOOTPRINT / STATS
  ========================================================== -->

  <section
    class="mx-auto max-w-6xl
    px-5
    py-7
    sm:px-6
    sm:py-8
    lg:px-8
    lg:py-9"
  >

    <div class="mb-6 text-center">

      <h2
        class="font-heading
        text-xl
        font-semibold
        tracking-[-0.025em]
        text-slate-900
        dark:text-slate-100
        sm:text-2xl
        md:text-[26px]"
      >
        Jejak & Dedikasi Publik
      </h2>

    </div>


    <div
      class="grid
      grid-cols-2
      text-center
      md:grid-cols-4
      md:divide-x
      md:divide-slate-200
      dark:md:divide-slate-800"
    >

      <!-- ITEM 1 -->

      <div
        class="border-b
        border-slate-200
        px-4
        py-5
        md:border-b-0
        dark:border-slate-800"
      >

        <div
          class="text-[20px]
          font-semibold
          leading-tight
          tracking-[-0.025em]
          text-blue-600
          dark:text-blue-400
          sm:text-[21px]
          md:text-[23px]"
        >
          2002
        </div>

        <div
          class="mx-auto
          mt-2
          max-w-[150px]
          text-[10px]
          uppercase
          leading-[1.5]
          tracking-[0.09em]
          text-slate-500
          dark:text-slate-400
          sm:text-[11px]"
        >
          Awal Langkah Pengabdian
        </div>

      </div>


      <!-- ITEM 2 -->

      <div
        class="border-b
        border-slate-200
        px-4
        py-5
        md:border-b-0
        dark:border-slate-800"
      >

        <div
          class="mx-auto
          max-w-[150px]
          text-[19px]
          font-semibold
          leading-[1.15]
          tracking-[-0.025em]
          text-blue-600
          dark:text-blue-400
          sm:text-[20px]
          md:text-[22px]"
        >
          Studi & Riset
        </div>

        <div
          class="mx-auto
          mt-2
          max-w-[155px]
          text-[10px]
          uppercase
          leading-[1.5]
          tracking-[0.09em]
          text-slate-500
          dark:text-slate-400
          sm:text-[11px]"
        >
          Hukum, Ekonomi & Kebijakan
        </div>

      </div>


      <!-- ITEM 3 -->

      <div class="px-4 py-5">

        <div
          class="mx-auto
          max-w-[150px]
          text-[19px]
          font-semibold
          leading-[1.15]
          tracking-[-0.025em]
          text-blue-600
          dark:text-blue-400
          sm:text-[20px]
          md:text-[22px]"
        >
          Kata.lo.gue
        </div>

        <div
          class="mx-auto
          mt-2
          max-w-[155px]
          text-[10px]
          uppercase
          leading-[1.5]
          tracking-[0.09em]
          text-slate-500
          dark:text-slate-400
          sm:text-[11px]"
        >
          Siniar & Bincang Santai
        </div>

      </div>


      <!-- ITEM 4 -->

      <div class="px-4 py-5">

        <div
          class="mx-auto
          max-w-[155px]
          text-[19px]
          font-semibold
          leading-[1.15]
          tracking-[-0.025em]
          text-blue-600
          dark:text-blue-400
          sm:text-[20px]
          md:text-[22px]"
        >
          Kemenkeu Mengajar
        </div>

        <div
          class="mx-auto
          mt-2
          max-w-[155px]
          text-[10px]
          uppercase
          leading-[1.5]
          tracking-[0.09em]
          text-slate-500
          dark:text-slate-400
          sm:text-[11px]"
        >
          Ruang Berbagi & Edukasi
        </div>

      </div>

    </div>

  </section>


  <!-- =========================================================
       PILAR PROFESIONAL & PERSONAL

       CUSTOM LAYOUT
       Tidak menggunakan Features3 supaya spacing poster
       dan pilar bisa dikontrol secara presisi.
  ========================================================== -->

  <section
    class="mx-auto
    max-w-6xl
    px-5
    pt-5
    pb-7
    sm:px-6
    sm:pt-6
    sm:pb-9
    lg:px-8"
  >

    <!-- TITLE -->

    <div
      class="mx-auto
      max-w-[650px]
      text-center"
    >

      <h2
        class="font-heading
        text-[23px]
        font-semibold
        leading-tight
        tracking-[-0.035em]
        text-slate-900
        dark:text-slate-100
        sm:text-[25px]
        md:text-[27px]"
      >
        Pilar Profesional & Personal
      </h2>


      <p
        class="mx-auto
        mt-2
        max-w-[540px]
        text-[10px]
        leading-[1.55]
        text-slate-500
        dark:text-slate-400
        sm:text-[11px]
        md:text-[12px]"
      >
        Enam dimensi utama yang membentuk perspektif kerja, kepenulisan, dan
        kontribusi publik:
      </p>

    </div>


    <!-- =====================================================
         3 PILAR ATAS
    ====================================================== -->

    <div
      class="mx-auto
      mt-7
      grid
      max-w-6xl
      grid-cols-1
      gap-6
      sm:grid-cols-3
      sm:gap-7
      md:gap-9"
    >

      <!-- TAX -->

      <div class="text-left">

        <div class="flex items-start gap-2.5">

          <div
            class="mt-[2px]
            flex
            h-5
            w-5
            shrink-0
            items-center
            justify-center
            rounded
            text-blue-600
            dark:text-blue-400"
          >

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M5 4h14v16H5z" />
              <path d="M8 8h8" />
              <path d="M8 12h8" />
              <path d="M8 16h5" />
            </svg>

          </div>


          <div>

            <h3
              class="text-[11px]
              font-semibold
              leading-[1.3]
              text-slate-900
              dark:text-slate-100
              sm:text-[11px]
              md:text-[12px]"
            >
              TAX / Administrasi Pajak
            </h3>

            <p
              class="mt-1.5
              text-[9px]
              leading-[1.5]
              text-slate-500
              dark:text-slate-400
              sm:text-[9.5px]
              md:text-[10px]"
            >
              Pengalaman dalam pelayanan wajib pajak, kepatuhan, serta
              administrasi perpajakan yang berkeadilan dan responsif.
            </p>

          </div>

        </div>

      </div>


      <!-- CONNECT -->

      <div class="text-left">

        <div class="flex items-start gap-2.5">

          <div
            class="mt-[2px]
            flex
            h-5
            w-5
            shrink-0
            items-center
            justify-center
            rounded
            text-blue-600
            dark:text-blue-400"
          >

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M3 21h18" />
              <path d="M5 21V5l7-3 7 3v16" />
              <path d="M9 21v-4h6v4" />
              <path d="M8 8h1" />
              <path d="M15 8h1" />
              <path d="M8 11h1" />
              <path d="M15 11h1" />
            </svg>

          </div>


          <div>

            <h3
              class="text-[11px]
              font-semibold
              leading-[1.3]
              text-slate-900
              dark:text-slate-100
              sm:text-[11px]
              md:text-[12px]"
            >
              CONNECT / Hubungan Kelembagaan
            </h3>

            <p
              class="mt-1.5
              text-[9px]
              leading-[1.5]
              text-slate-500
              dark:text-slate-400
              sm:text-[9.5px]
              md:text-[10px]"
            >
              Menghubungkan otoritas pajak dengan media, instansi pemerintah,
              dan ekosistem publik untuk membangun komunikasi yang terbuka.
            </p>

          </div>

        </div>

      </div>


      <!-- EDUCATE -->

      <div class="text-left">

        <div class="flex items-start gap-2.5">

          <div
            class="mt-[2px]
            flex
            h-5
            w-5
            shrink-0
            items-center
            justify-center
            rounded
            text-blue-600
            dark:text-blue-400"
          >

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            </svg>

          </div>


          <div>

            <h3
              class="text-[11px]
              font-semibold
              leading-[1.3]
              text-slate-900
              dark:text-slate-100
              sm:text-[11px]
              md:text-[12px]"
            >
              EDUCATE / Edukasi & Tax Center
            </h3>

            <p
              class="mt-1.5
              text-[9px]
              leading-[1.5]
              text-slate-500
              dark:text-slate-400
              sm:text-[9.5px]
              md:text-[10px]"
            >
              Pengembangan Tax Center di perguruan tinggi, pembimbingan
              relawan pajak, dan penguatan literasi perpajakan generasi muda.
            </p>

          </div>

        </div>

      </div>

    </div>


    <!-- =====================================================
         POSTER
    ====================================================== -->

    <div
      class="mx-auto
      mt-5
      w-full
      sm:mt-6"
    >

      <Image
        src={tentangImage2}
        alt="Perempuan profesional dengan nuansa Jepang sedang menulis dan bekerja dengan elemen budaya Jepang"
        class="block
        h-[190px]
        w-full
        rounded-lg
        object-cover
        object-center
        shadow-sm
        sm:h-[230px]
        sm:rounded-xl
        md:h-[280px]
        lg:h-[300px]"
        widths={[700, 1000, 1400]}
        sizes="(max-width: 768px) 100vw, 1152px"
        loading="lazy"
        format="webp"
        quality={88}
      />

    </div>


    <!-- =====================================================
         3 PILAR BAWAH

         Jarak poster → pilar = 16px
    ====================================================== -->

    <div
      class="mx-auto
      mt-4
      grid
      max-w-6xl
      grid-cols-1
      gap-6
      sm:grid-cols-3
      sm:gap-7
      md:gap-9"
    >

      <!-- WRITE -->

      <div class="text-left">

        <div class="flex items-start gap-2.5">

          <div
            class="mt-[2px]
            flex
            h-5
            w-5
            shrink-0
            items-center
            justify-center
            rounded
            text-blue-600
            dark:text-blue-400"
          >

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4Z" />
            </svg>

          </div>


          <div>

            <h3
              class="text-[11px]
              font-semibold
              leading-[1.3]
              text-slate-900
              dark:text-slate-100
              sm:text-[11px]
              md:text-[12px]"
            >
              WRITE / Opini & Editing
            </h3>

            <p
              class="mt-1.5
              text-[9px]
              leading-[1.5]
              text-slate-500
              dark:text-slate-400
              sm:text-[9.5px]
              md:text-[10px]"
            >
              Menulis artikel publikasi resmi, menyunting pemberitaan
              institusi, serta memoderasi lokakarya penulisan opini.
            </p>

          </div>

        </div>

      </div>


      <!-- REFLECT -->

      <div class="text-left">

        <div class="flex items-start gap-2.5">

          <div
            class="mt-[2px]
            flex
            h-5
            w-5
            shrink-0
            items-center
            justify-center
            rounded
            text-blue-600
            dark:text-blue-400"
          >

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <circle cx="12" cy="12" r="9" />
              <path d="M12 7v5l3 2" />
            </svg>

          </div>


          <div>

            <h3
              class="text-[11px]
              font-semibold
              leading-[1.3]
              text-slate-900
              dark:text-slate-100
              sm:text-[11px]
              md:text-[12px]"
            >
              REFLECT / Refleksi Kebijakan
            </h3>

            <p
              class="mt-1.5
              text-[9px]
              leading-[1.5]
              text-slate-500
              dark:text-slate-400
              sm:text-[9.5px]
              md:text-[10px]"
            >
              Menghubungkan pengalaman kerja dan isu kebijakan publik dengan
              analogi sederhana yang dekat dengan kehidupan masyarakat.
            </p>

          </div>

        </div>

      </div>


      <!-- MOVE -->

      <div class="text-left">

        <div class="flex items-start gap-2.5">

          <div
            class="mt-[2px]
            flex
            h-5
            w-5
            shrink-0
            items-center
            justify-center
            rounded
            text-blue-600
            dark:text-blue-400"
          >

            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-4 w-4"
            >
              <circle cx="12" cy="5" r="2" />
              <path d="M10 22l2-7 2 7" />
              <path d="M8 9l4 3 4-3" />
              <path d="M5 14l3-2" />
              <path d="M19 14l-3-2" />
            </svg>

          </div>


          <div>

            <h3
              class="text-[11px]
              font-semibold
              leading-[1.3]
              text-slate-900
              dark:text-slate-100
              sm:text-[11px]
              md:text-[12px]"
            >
              MOVE / Running & Stamina
            </h3>

            <p
              class="mt-1.5
              text-[9px]
              leading-[1.5]
              text-slate-500
              dark:text-slate-400
              sm:text-[9.5px]
              md:text-[10px]"
            >
              Rutinitas berlari 5 km sebelum bekerja sebagai bagian dari
              menjaga stamina, fokus, dan keseimbangan hidup.
            </p>

          </div>

        </div>

      </div>

    </div>

  </section>


  <!-- =========================================================
       PRINCIPLES & VALUES
  ========================================================== -->

  <section
    class="py-6
    sm:py-8"
  >

    <Steps2
      title="Prinsip & Nilai Pelayanan"
      subtitle="Nilai-nilai fundamental yang melandasi setiap langkah pelayanan publik dan hubungan masyarakat:"
      items={[
        {
          title: 'Integritas & Akuntabilitas Sektor Publik',
          description:
            'Menjaga amanah tata kelola keuangan negara dengan keterbukaan, kepatuhan pada aturan, dan penyampaian informasi yang akurat.',
        },
        {
          title: 'Komunikasi Publik yang Inklusif & Empatis',
          description:
            'Menyampaikan kebijakan perpajakan yang rumit menjadi narasi yang mudah dipahami dan relevan bagi seluruh lapisan masyarakat.',
        },
        {
          title: 'Sinergi & Kolaborasi Kelembagaan',
          description:
            'Membangun hubungan yang harmonis dan produktif dengan akademisi, media massa, serta institusi pemerintah daerah.',
        },
      ]}
    />

  </section>


  <!-- =========================================================
       CAREER TIMELINE
  ========================================================== -->

  <section
    class="py-6
    sm:py-8"
  >

    <Timeline
      id="history"
      tagline="JOURNEY / Perjalanan Terverifikasi"
      title="Rekam Karier & Akademik"
      subtitle="Jejak penugasan struktural, rekam akademik, dan aktivitas publik yang tercatat secara terbuka:"
      layout="alternate"
      items={[
        {
          date: '2002',
          title: 'Awal Masa Kedinasan DJP',
          description:
            'Memulai pengabdian di Direktorat Jenderal Pajak, Kementerian Keuangan Republik Indonesia.',
          icon: 'tabler:briefcase',
        },
        {
          date: '2010–2011',
          title: 'Studi S2 & Riset Akademik (Unpad)',
          description:
            'Penelitian tesis mengenai kepatuhan wajib pajak: "Enhancing taxpayer compliance in Indonesia: A Case study of account representatives di Tasikmalaya" di Universitas Padjadjaran.',
          icon: 'tabler:certificate',
        },
        {
          date: '2019',
          title: 'Kasi Kerja Sama & Humas (DJP Banten)',
          description:
            'Berdasarkan KEP-581/PJ/2019, dimutasi dari Kepala Seksi Pelayanan KPP Pratama Banda Aceh menjadi Kepala Seksi Kerja Sama dan Hubungan Masyarakat Kanwil DJP Banten.',
          icon: 'tabler:news',
        },
        {
          date: '2022–2024',
          title: 'Lighthouse Team, Siniar & Literasi',
          description:
            'Anggota Lighthouse Team Kanwil DJP Banten (KMK 112/2022), moderator podcast "Kata.lo.gue", serta penggerak Club Literacy & Tax Center kampus.',
          icon: 'tabler:microphone',
        },
        {
          date: 'Saat ini',
          title: 'KPP Madya Dua Jakarta Barat',
          description:
            'Bertugas di KPP Madya Dua Jakarta Barat, aktif sebagai Relawan Pengajar Kemenkeu Mengajar serta menulis opini publik.',
          icon: 'tabler:building-bank',
          highlight: true,
        },
      ]}
    />

  </section>


  <!-- =========================================================
       NETWORK / PUBLIC POLICY
  ========================================================== -->

  <section
    class="py-6
    sm:py-8"
  >

    <Features2
      title="Fokus Wilayah & Jejaring Kebijakan"
      tagline="LOCATIONS & NETWORK"
      columns={3}
      items={[
        {
          title: 'Kanwil DJP Banten & Jakarta Barat',
          description:
            'Pusat penugasan hubungan masyarakat, pelayanan unit vertikal, media visit, dan kemitraan Tax Center.',
          icon: 'tabler:map-pin',
        },
        {
          title: 'Kemenkeu Mengajar & Kampus',
          description:
            'Jejak pengabdian edukasi di lingkungan universitas dan program sekolah Kemenkeu Mengajar.',
          icon: 'tabler:school',
        },
        {
          title: 'Media & Publik Digital',
          description:
            'Kolaborasi dengan media daerah, insan pers, serta saluran komunikasi digital resmi institusi.',
          icon: 'tabler:device-tv',
        },
      ]}
    />

  </section>


  <!-- =========================================================
       CONTACT
  ========================================================== -->

  <section
