---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Timeline from '~/components/widgets/Timeline.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Tentang / プロフィール — Ida Rosnida Laila',
  description: 'Profil profesional, perjalanan karier di DJP, karya tulis, dan refleksi kepenulisan Ida Rosnida Laila, S.H., M.E., M.Ids.',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="ABOUT / プロフィール"
    image={{
      src: 'https://images.unsplash.com/photo-1455390582262-044cdead277a?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Ida Rosnida Laila Profile Workspace',
    }}
  >
    <Fragment slot="title">
      Pajak, Kebijakan, dan <br />
      <span class="text-accent dark:text-blue-400">Cerita di Balik Angka</span>
    </Fragment>

    <Fragment slot="subtitle">
      Ida Rosnida Laila, S.H., M.E., M.Ids. adalah profesional perpajakan dan komunikator sektor publik di Direktorat Jenderal Pajak, Kementerian Keuangan Republik Indonesia. Perjalanan kariernya membentang dari pelayanan wajib pajak, komunikasi publik, hubungan kelembagaan, hingga edukasi dan literasi perpajakan di tingkat regional.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Jejak & Dedikasi Publik"
    classes={{
      title: 'text-xl md:text-3xl font-bold tracking-tight mb-8 text-center font-heading',
      amount: 'text-xl sm:text-2xl md:text-2xl font-extrabold text-blue-600 dark:text-blue-400 tracking-tight leading-tight',
      titleItem: 'text-xs sm:text-sm font-medium uppercase tracking-wider text-slate-600 dark:text-slate-400 mt-2 text-center',
    }}
    stats={[
      { amount: '2002', title: 'Perjalanan Abdi Negara' },
      { amount: 'S.H., M.E., M.Ids.', title: 'Pendidikan & Studi' },
      { amount: 'Kata.lo.gue', title: 'Ruang Bincang Kebijakan' },
      { amount: 'KM 10', title: 'Kontribusi & Literasi' },
    ]}
  />

  <!-- Features3 Widget (Pilar Utama) ************** -->

  <Features3
    title="Pilar Profesional & Personal"
    subtitle="Enam dimensi utama yang membentuk perspektif kerja, kepenulisan, dan kontribusi publik:"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'TAX / Administrasi Pajak',
        description:
          'Pengalaman mendalam dalam pelayanan wajib pajak, kepatuhan, serta administrasi perpajakan yang berkeadilan dan responsif.',
        icon: 'tabler:receipt-tax',
      },
      {
        title: 'CONNECT / Hubungan Kelembagaan',
        description:
          'Menghubungkan otoritas pajak dengan media, instansi pemerintah (BPK/Pemda), serta ekosistem publik untuk transparansi informasi.',
        icon: 'tabler:building-community',
      },
      {
        title: 'EDUCATE / Edukasi & Tax Center',
        description:
          'Pengembangan Tax Center di perguruan tinggi, pembimbingan relawan pajak, dan literasi bagi generasi muda.',
        icon: 'tabler:school',
      },
    ]}
  />

  <!-- Features3 Widget (Pilar Lanjutan) ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'WRITE / Opini & Editing',
        description:
          'Menulis artikel publikasi resmi, menyunting pemberitaan institusi, serta memoderasi lokakarya penulisan opini.',
        icon: 'tabler:pencil',
      },
      {
        title: 'REFLECT / Refleksi Kebijakan',
        description:
          'Menghubungkan pengalaman kerja dan isu kebijakan publik dengan analogi sederhana yang dekat dengan kehidupan masyarakat.',
        icon: 'tabler:bulb',
      },
      {
        title: 'MOVE / Running & Stamina',
        description:
          'Rutinitas berlari 5 km sebelum bekerja sebagai fondasi menjaga stamina, fokus, dan keseimbangan hidup.',
        icon: 'tabler:run',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1434030216411-0b793f4b4173?ixlib=rb-4.0.3&auto=format&fit=crop&w=1740&q=80',
      alt: 'Writing and Reflection',
    }}
  />

  <!-- Steps2 Widget (Prinsip Kerja & Nilai) ****************** -->

  <Steps2
    title="Prinsip & Nilai Pelayanan"
    subtitle="Nilai-nilai fundamental yang melandasi setiap langkah pelayanan publik dan hubungan masyarakat:"
    items={[
      {
        title: 'Integritas & Akuntabilitas Sektor Publik',
        description:
          'Menjaga amanah tata kelola keuangan negara dengan keterbukaan, kepatuhan pada aturan, dan penyampaian informasi yang akurat.',
      },
      {
        title: 'Komunikasi Publik yang Inklusif & Empatis',
        description:
          'Menyampaikan kebijakan perpajakan yang rumit menjadi narasi yang mudah dipahami dan relevan bagi seluruh lapisan masyarakat.',
      },
      {
        title: 'Sinergi & Kolaborasi Kelembagaan',
        description:
          'Membangun hubungan yang harmonis dan produktif dengan akademisi, media massa, serta institusi pemerintah daerah.',
      },
    ]}
  />

  <!-- Timeline Widget (Karier & Penugasan Terverifikasi) **************** -->

  <Timeline
    id="history"
    tagline="JOURNEY / Perjalanan Terverifikasi"
    title="Rekam Karier & Akademik"
    subtitle="Jejak penugasan struktural, rekam akademik, dan aktivitas publik yang tercatat secara terbuka:"
    layout="alternate"
    items={[
      {
        date: '2002',
        title: 'Awal Masa Kedinasan DJP',
        description: 'Memulai pengabdian di Direktorat Jenderal Pajak, Kementerian Keuangan Republik Indonesia.',
        icon: 'tabler:briefcase',
      },
      {
        date: '2010–2011',
        title: 'Studi S2 & Riset Akademik (Unpad)',
        description:
          'Penelitian tesis kepatuhan wajib pajak: "Enhancing taxpayer compliance in Indonesia: A Case study of account representatives di Tasikmalaya" di Universitas Padjadjaran.',
        icon: 'tabler:certificate',
      },
      {
        date: '2019',
        title: 'Kasi Kerja Sama & Humas (DJP Banten)',
        description:
          'Berdasarkan KEP-581/PJ/2019, dimutasi dari Kepala Seksi Pelayanan KPP Pratama Banda Aceh menjadi Kepala Seksi Kerja Sama dan Hubungan Masyarakat Kanwil DJP Banten.',
        icon: 'tabler:news',
      },
      {
        date: '2022–2024',
        title: 'Lighthouse Team, Siniar & Literasi',
        description:
          'Anggota Lighthouse Team Kanwil DJP Banten (KMK 112/2022), moderator podcast "Kata.lo.gue", serta penggerak Club Literacy & Tax Center kampus.',
        icon: 'tabler:microphone',
      },
      {
        date: 'Saat ini',
        title: 'KPP Madya Dua Jakarta Barat',
        description:
          'Menjalankan amanah berdinas di KPP Madya Dua Jakarta Barat, sembari terus aktif sebagai Relawan Pengajar Kemenkeu Mengajar serta menulis opini publik.',
        icon: 'tabler:building-bank',
        highlight: true,
      },
    ]}
  />

  <!-- Features2 Widget (Area Keberadaan & Jejaring) ************** -->

  <Features2
    title="Fokus Wilayah & Jejaring Kebijakan"
    tagline="LOCATIONS & NETWORK"
    columns={3}
    items={[
      {
        title: 'Kanwil DJP Banten & Jakarta Barat',
        description: 'Pusat penugasan hubungan masyarakat, pelayanan unit vertikal, media visit, dan kemitraan Tax Center.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Kemenkeu Mengajar & Kampus',
        description: 'Jejak pengabdian edukasi di lingkungan universitas (UIN, Matana, UNIS) dan program sekolah Kemenkeu Mengajar.',
        icon: 'tabler:school',
      },
      {
        title: 'Media & Publik Digital',
        description: 'Kolaborasi dengan RRI Banten, insan pers daerah, serta saluran komunikasi digital resmi institusi.',
        icon: 'tabler:device-tv',
      },
    ]}
  />

  <!-- Features2 Widget (Sapa & Kontak Ringkas) ************** -->

  <Features2
    title="Mari Terhubung"
    tagline="CONTACT / つながる"
    columns={2}
    items={[
      {
        title: 'Diskusi & Kirim Pesan',
        description:
          'Terbuka untuk ruang diskusi seputar literasi perpajakan, penulisan opini, maupun penguatan Tax Center.',
        icon: 'tabler:messages',
        callToAction: {
          text: 'Ke Halaman Kontak',
          href: '/contact',
        },
      },
      {
        title: 'Jejak Sosial Media',
        description:
          'Ikuti catatan harian, aktivitas berlari, dan dokumentasi kegiatan publik melalui akun Instagram resmi.',
        icon: 'tabler:brand-instagram',
        callToAction: {
          text: '@idar.layla',
          href: 'https://www.instagram.com/idar.layla/',
          target: '_blank',
        },
      },
    ]}
  />
</Layout>