---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Image from '~/components/common/Image.astro';
import { getColumnsClass } from '~/utils/utils';
import type { Content as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  callToAction,
  items = [],
  columns,
  image = await Astro.slots.render('image'),
  isReversed = false,
  isAfterContent = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const columnsClass = getColumnsClass(columns);

// `image.aspect` decides the crop: square by default, 4/3, portrait, or the
// natural height without cropping (`auto`).
const { aspect = '1/1', ...imageProps } = typeof image === 'object' && image ? image : { src: '', alt: '' };
const aspectClass = {
  '4/3': 'aspect-[4/3] object-cover',
  '1/1': 'aspect-square object-cover',
  '3/4': 'aspect-[3/4] object-cover',
  auto: '',
}[aspect];
const aspectSize = {
  '4/3': { width: 640, height: 480 },
  '1/1': { width: 640, height: 640 },
  '3/4': { width: 480, height: 640 },
  auto: { width: 640, height: undefined },
}[aspect];
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${isAfterContent ? 'pt-0 md:pt-0 lg:pt-0' : ''} ${classes?.container ?? ''}`}
  bg={bg}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={{
      container: 'max-w-xl sm:mx-auto lg:max-w-2xl text-center mb-8',
      title: 'text-3xl md:text-4xl font-bold tracking-tight mb-4 font-heading text-slate-900 dark:text-white',
      subtitle: 'max-w-3xl mx-auto text-lg text-slate-600 dark:text-slate-300 font-light',
      tagline: 'text-xs uppercase tracking-widest text-blue-600 dark:text-blue-400 font-semibold mb-2',
      ...((classes?.headline as Record<string, string>) ?? {}),
    }}
  />
  <div class="mx-auto max-w-7xl px-0 py-2 md:px-2">
    <div class={`md:flex ${isReversed ? 'md:flex-row-reverse' : ''} md:gap-16`}>
      <div class="md:basis-1/2 self-center">
        {content && <div class="mb-8 text-base md:text-lg text-slate-700 dark:text-slate-300 leading-relaxed font-normal" set:html={content} />}

        {
          callToAction && (
            <div class="mb-8 text-primary dark:text-blue-400">
              <Button variant="link" classes={{ label: 'text-base font-medium underline underline-offset-4 decoration-blue-500 hover:text-blue-600' }} {...callToAction} />
            </div>
          )
        }

        {
          items.length > 0 && (
            <div class:list={['grid mx-auto gap-y-6 md:gap-y-8 gap-8', columnsClass]}>
              {items.map(({ title: itemTitle, description, icon, callToAction }) => (
                <div class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
                  <div class="flex flex-row max-w-none items-start">
                    <div class="flex shrink-0 justify-center">
                      <Icon
                        name={icon || 'tabler:check'}
                        class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-50 dark:bg-slate-800 text-blue-600 dark:text-blue-400 p-1.5 border border-blue-100 dark:border-slate-700 shadow-sm mr-3 rtl:mr-0 rtl:ml-3"
                      />
                    </div>
                    <div class="mt-0.5">
                      {itemTitle && (
                        <h3 class="text-base font-semibold leading-6 text-slate-900 dark:text-white">
                          {itemTitle}
                        </h3>
                      )}
                      {description && (
                        <p
                          class:list={[{ 'mt-1.5': itemTitle }, 'text-sm text-slate-600 dark:text-slate-400 leading-relaxed']}
                          set:html={description}
                        />
                      )}
                      {callToAction && (
                        <div
                          class:list={[
                            { 'mt-2': itemTitle || description },
                            'text-sm font-medium leading-6 dark:text-white',
                          ]}
                        >
                          <Button variant="link" classes={{ label: 'text-sm underline underline-offset-4' }} {...callToAction} />
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )
        }
      </div>
      <div class="mt-10 md:mt-0 md:basis-1/2 self-center">
        {
          image && (
            <div class="relative m-auto max-w-4xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  class:list={['mx-auto w-full rounded-xl bg-slate-100 dark:bg-slate-800 shadow-md border border-slate-200/50 dark:border-slate-800', aspectClass]}
                  width={aspectSize.width}
                  height={aspectSize.height}
                  widths={[400, 640, 960]}
                  sizes="(max-width: 767px) 100vw, 640px"
                  layout="constrained"
                  format="webp"
                  {...imageProps}
                />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</WidgetWrapper>