---
// Thin bar above the header. Everything is a prop so a site can change the
// message without touching the component; the defaults reproduce the demo.
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
  showStars?: boolean;
}

const {
  badge = 'NEW',
  text = 'IDA ROSNIDA LAILA',
  icon = 'Instagram',
  essential: true,
} = Astro.props;
---

<div
  class="text-sm bg-pink-300 text-pink-950 white:bg-transparent white:border-b white:border-slate-800 white:text-slate-400 hidden lg:flex gap-1 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap"
>
  {
    badge && (
      <span class="bg-white/20 white:bg-pink-300 text-slate-100 white:text-slate-300 font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block">
        {badge}
      </span>
    )
  }
  {
    text &&
      (href ? (
        <a href={href} class="text-slate-300 hover:underline white:text-slate-400 font-medium" set:html={text} />
      ) : (
        <span class="text-slate-300 white:text-slate-400 font-medium" set:html={text} />
      ))
  }

  {
    instagram && (
      <a
        href="https://www.instagram.com/idar.layla/"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 text-pink-400 hover:text-pink-300 font-medium"
      >
        Instagram
      </a>
    )
  }
</div>
