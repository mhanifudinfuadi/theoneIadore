---
// Thin bar above the header. Everything is a prop so a site can change the
// message without touching the component; the defaults reproduce the demo.
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
  showStars?: boolean;
}

const {
  badge = 'IRL',
  text = 'IDA ROSNIDA LAILA',
  href,
  instagram = true,
} = Astro.props;
---

<div
  class="text-sm bg-pink-200 text-blue-800 white:bg-orange-100 white:border-b white:border-white-500 hidden lg:flex gap-1 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap"
> 
  {
    badge && (
      <span class="bg-white/20 white:bg-pink-600 text-blue-800 font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block">
        {badge}
      </span>
    )
  }
  {
    text &&
      (href ? (
        <a href={href} class="text-blue-500 hover:underline white:text-blue-500 font-medium" set:html={text} />
      ) : (
        <span class="text-blue-300 white:text-blue-400 font-medium" set:html={text} />
      ))
  }

  {
    instagram && (
      <a
        href="https://www.instagram.com/idar.layla/"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-2 text-pink-800 hover:text-pink-600 font-medium"
      >
        Instagram
      </a>
    )
  }
</div>
