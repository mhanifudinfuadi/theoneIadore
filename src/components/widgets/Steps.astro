<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-5xl ${classes?.container ?? ''}`}
  bg={bg}
>
  <div
    class:list={[
      'flex flex-col gap-8 md:gap-12',
      { 'md:flex-row-reverse': isReversed },
      { 'md:flex-row': image },
    ]}
  >
    <div
      class:list={[
        'md:py-4 md:self-center',
        { 'md:basis-[45%]': image },
        { 'w-full': !image },
      ]}
    >
      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'text-left rtl:text-right',
          title: 'text-3xl lg:text-4xl',
          ...((classes?.headline as object) ?? {}),
        }}
      />

      <Timeline
        items={items}
        classes={classes?.items as Record<string, never>}
      />

      <div class="mt-10">
        <slot name="content" />
      </div>

      {
        typeof callToAction === 'string' ? (
          <Fragment set:html={callToAction} />
        ) : (
          callToAction &&
          callToAction.text &&
          callToAction.href && (
            <div class="mt-8">
              <Button variant="primary" {...callToAction} class="w-auto" />
            </div>
          )
        )
      }
    </div>

    {
      image && (
        <div class="relative md:basis-[55%]">
          {typeof image === 'string' ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="inset-0 object-cover object-top w-full rounded-md shadow-lg md:absolute md:h-full bg-gray-400 dark:bg-slate-700"
              widths={[400, 768]}
              sizes="(max-width: 768px) 100vw, 500px"
              width={500}
              height={768}
              layout="cover"
              format="webp"
              src={image?.src}
              alt={image?.alt || ''}
            />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>