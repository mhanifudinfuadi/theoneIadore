---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { Steps as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  callToAction = await Astro.slots.render('callToAction'),
  image = await Astro.slots.render('image'),
  isReversed = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl ${classes?.container ?? ''}`} bg={bg}>
  <div class:list={['flex flex-col gap-8 md:gap-12', { 'md:flex-row-reverse': isReversed }, { 'md:flex-row': image }]}>
<div class:list={['md:py-4 md:self-start', { 'md:basis-[45%]': image }, { 'w-full': !image }]}>      <Headline
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'text-left rtl:text-right',
          title: 'text-3xl lg:text-4xl',
          ...((classes?.headline as object) ?? {}),
        }}
      />
      <Timeline items={items} classes={classes?.items as Record<string, never>} />

      <div class="mt-10">
        
      </div>
      {
        typeof callToAction === 'string' ? (
          <Fragment set:html={callToAction} />
        ) : (
          callToAction &&
          callToAction.text &&
          callToAction.href && (
            <div class="mt-14">
              <Button variant="primary" {...callToAction} class="w-auto" />
            </div>
          )
        )
      }
    </div>
{
  image && (
    <div class="relative md:basis-[55%] self-start">
      {typeof image === 'string' ? (
        <Fragment set:html={image} />
      ) : (
        <Image
          class="w-full h-auto rounded-md shadow-lg bg-gray-400 dark:bg-slate-700"
          widths={[400, 768, 1024]}
          sizes="(max-width: 768px) 100vw, 55vw"
          width={1024}
          height={1024}
          layout="constrained"
          format="webp"
          src={image?.src}
          alt={image?.alt || ''}
        />
      )}

      <div class="mt-8">
        <slot name="content" />
      </div>
    </div>
  )
}
  </div>
</WidgetWrapper>
