---
import { Icon } from 'astro-icon/components';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  theme?: string;
}

const {
  socialLinks = [],
  theme = 'light',
} = Astro.props;
---

<footer
  class:list={[
    { dark: theme === 'dark' },
    'relative border-t border-gray-200 dark:border-slate-800 not-prose',
  ]}
>
  <!-- Background -->
  <div
    class="dark:bg-dark absolute inset-0 pointer-events-none"
    aria-hidden="true"
  ></div>

  <div
    class="relative mx-auto max-w-7xl px-6 sm:px-8"
  >
    <!-- Main footer -->
    <div class="flex flex-col items-center justify-center py-16 md:py-20">

      <!-- Personal identity -->
      <div class="text-center mb-12">
        <a
          href="/"
          class="inline-block text-xl font-semibold tracking-tight text-gray-800 dark:text-white"
        >
          Ida Rosnida Laila
        </a>

        <p class="mt-2 text-xs tracking-[0.25em] uppercase text-muted dark:text-gray-400">
          Aida Leyla · Service · Knowledge · Words
        </p>
      </div>


      <!-- Main quote -->
      <div class="mx-auto max-w-4xl text-center">

        <p
          class="text-2xl leading-relaxed tracking-tight text-gray-800 dark:text-gray-100 sm:text-3xl md:text-4xl lg:text-[2.6rem]"
        >
          For every journey leaves a story,
          and every story leaves a meaning.
        </p>

        <p
          class="mt-5 text-base leading-relaxed text-muted dark:text-gray-400 sm:text-lg md:text-xl"
        >
          すべての旅には物語があり、
          すべての物語には意味がある。
        </p>

      </div>


      <!-- Instagram -->
      {
        socialLinks?.length > 0 && (
          <div class="mt-10">
            {socialLinks.map(({ ariaLabel, href, icon }) => (
              <a
                href={href}
                aria-label={ariaLabel}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-full p-3 text-muted transition duration-200 hover:bg-gray-100 hover:text-gray-900 dark:text-gray-400 dark:hover:bg-gray-800 dark:hover:text-white"
              >
                {icon && <Icon name={icon} class="h-6 w-6" />}
              </a>
            ))}
          </div>
        )
      }


      <!-- Divider -->
      <div class="mt-8 h-px w-32 bg-gray-200 dark:bg-gray-700"></div>


      <!-- Copyright -->
      <div class="mt-7 text-center">
        <p class="text-xs text-muted dark:text-gray-500">
          © 2026 Ida Rosnida Laila · Aida Leyla
        </p>
      </div>

    </div>
  </div>
</footer>